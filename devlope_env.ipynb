   "source": [
    "# Saving Python scripts as .py files\n",
    "import numpy as np\n",
    "from matplotlib import pyplot as plt\n",
    "\n",
    "rad = np.linspace(0, 2 * np.pi, 200)\n",
    "\n",
    "x = np.sin(rad) ** 3\n",
    "y = 20 * np.cos(rad) - 10 * np.cos(2 * rad) - 5 * np.cos(3 * rad) - 2 * np.cos(4 * rad)\n",
    "\n",
    "plt.plot(x, y)\n",
    "plt.show()"
   ]
  },
